# Iris local personal credentials (TEMPLATE).
#
# Copy this file to ".env.local" and fill in your real values:
#     cp .env.local.example .env.local
#
# ".env.local" is gitignored and is NEVER committed or pushed. When it exists,
# scripts/build-shortcuts.sh injects these values into YOUR local build so you
# do not have to re-paste keys in the Shortcuts editor after every import.
# CI and any distributed build have no .env.local, so they stay on the safe
# "...-REPLACE-ME" placeholders.
#
# Leave a value blank (or containing REPLACE-ME) to keep that placeholder.
# Do NOT run validate-shortcut.py on a credential-injected build; it will (by
# design) fail because real keys are present. Only distribute placeholder builds.

# NVIDIA NIM API key (required) - from build.nvidia.com/settings/api-keys, starts with nvapi-
NIM_API_KEY=

# Optional: override the default model id (default: meta/llama-3.1-8b-instruct)
NIM_MODEL_ID=

# Optional: Tavily web search key - from app.tavily.com, starts with tvly-
TAVILY_KEY=

# Optional: Google (Tasks + Gmail) + future services, via the Apps Script proxy.
# Deploy the web app from docs/apps-script-proxy.md, then paste its /exec URL and
# the shared secret you set inside the script. Leave blank to disable these tools.
IRIS_PROXY_URL=
IRIS_PROXY_SECRET=
